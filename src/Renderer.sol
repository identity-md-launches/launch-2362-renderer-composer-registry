pragma solidity 0.8.24;

import {Base64} from "@openzeppelin/contracts/utils/Base64.sol";
import {Strings} from "@openzeppelin/contracts/utils/Strings.sol";
import {Card, OracleMeta} from "./Types.sol";
import {TemplateData} from "./TemplateData.sol";
import {HiveData} from "./HiveData.sol";

/// @notice Turns one `Card` into a `data:application/json;base64,...` URI, fully onchain.
/// @dev    The metadata envelope (JSON with one slot for the percent-encoded image) is a compile-time
///         `bytes constant` in this contract's code (`TemplateData`, generated by `tools/gen_template.py`;
///         solc reads it with `codecopy`), cut into fixed slices by the constant offsets. Rendering copies
///         slice, value, slice, value ... into one buffer and Base64-encodes it once. The image is the hive
///         card: thirteen hexagonal cells, one per family, built by selecting precomputed, pre-encoded
///         coordinate strings from `HiveData` (the generator's `hive_svg` is the normative drawing; there is
///         no trigonometry here). No constructor arguments, no immutables, no storage.
/// @dev The registry reads a card is built from.
interface ICardSource {
    function claimantOf(uint256 tokenId) external view returns (address);
    function traitsOf(address wallet) external view returns (uint16[] memory);
    function verifiedSpecsOf(address wallet) external view returns (uint16[] memory);
    function verified(address claimant, uint16 traitId) external view returns (bytes32, bytes32, uint64, uint64);
}

contract Renderer {
    uint256 internal constant MAX_COMMUNITY_IN_METADATA = 32;
    uint256 internal constant SLOTS = 21; // TemplateData.SLOTS; a literal because it sizes a memory array
    uint256 internal constant SLICES = 22;
    uint256 internal constant MAX_RINGS_SHOWN = 39;

    /// @dev An append-only byte buffer that doubles when full; `len` is the bytes written so far.
    struct Buf {
        bytes data;
        uint256 len;
    }

    /// @dev The hive tables, copied out of code once per image.
    struct Hive {
        bytes points;
        bytes pointStarts; // packed big-endian uint16, N+1 entries
        bytes fragments;
        bytes fragmentStarts;
    }

    /// @dev The generated tables are ASCII hex (so the code data holds no forbidden opcode byte);
    ///      decode one to packed bytes.
    function _unhex(bytes memory h) internal pure returns (bytes memory out) {
        out = new bytes(h.length / 2);
        // Only the generator's ASCII hex constants reach this helper.
        assembly ("memory-safe") {
            let p := add(h, 32)
            let dst := add(out, 32)
            let end := add(dst, mload(out))
            for {} lt(dst, end) {
                dst := add(dst, 1)
                p := add(p, 2)
            } {
                let a := byte(0, mload(p))
                let b := byte(1, mload(p))
                a := sub(a, add(48, mul(gt(a, 96), 39)))
                b := sub(b, add(48, mul(gt(b, 96), 39)))
                mstore8(dst, or(shl(4, a), b))
            }
        }
    }

    error NoCard(uint256 tokenId);
    error UnknownTrait(uint16 traitId);

    /// @dev The 25 catalog names of CATALOG.md section 7 (final names, 2026-10-16), packed in catalog order
    ///      with one length byte each; a family's first index and tier count select the entry.
    bytes internal constant NAMES =
        "SpawnedZero-Shot, hour <= 1Zero-Shot, hour 0Hopper >= 3Hopper >= 5Hopper >= 10Bullfrog >= 1 ETHBullfrog >= 10 ETHBullfrog >= 100 ETHBullfrog >= 800 ETHBenchmarked >= 1000Benchmarked >= 3162Benchmarked >= 10000SwarmedUptimeHoldoutFinal TokenHotfixPID #1PID #1000PID #10000PID #19522First thousandTop WeightsPretrained";
    bytes internal constant NAME_LENS = hex"0714110b0b0c111213131313140706070b0606090a0a0e0b0a";
    bytes internal constant FAMILY_BASE = hex"000103060a0d0e0f1011121718";
    bytes internal constant FAMILY_TIERS = hex"01020304030101010101050101";

    /// @notice The name table of CATALOG.md section 7 for the 25 catalog ids; reverts for any other id.
    function traitName(uint16 traitId) external pure returns (string memory) {
        uint256 fam = traitId / 100;
        uint256 tier = traitId % 100;
        if (fam < 1 || fam > 13 || tier < 1 || tier > uint8(FAMILY_TIERS[fam - 1])) revert UnknownTrait(traitId);
        uint256 index = uint8(FAMILY_BASE[fam - 1]) + tier - 1;
        uint256 start;
        for (uint256 i; i < index; ++i) {
            start += uint8(NAME_LENS[i]);
        }
        uint256 len = uint8(NAME_LENS[index]);
        bytes memory out = new bytes(len);
        bytes memory all = NAMES;
        assembly ("memory-safe") {
            mcopy(add(out, 0x20), add(add(all, 0x20), start), len)
        }
        return string(out);
    }

    /// @dev Internal since V2 item 19 / the size budget: the Card ABI decoder was a quarter of the runtime.
    ///      `test/mocks/RendererHarness.sol` exposes it, `preimage` and `image` to the tests.
    function tokenURI(Card memory c) internal pure returns (string memory) {
        return string(abi.encodePacked("data:application/json;base64,", Base64.encode(preimage(c))));
    }

    /// @notice A rendering from caller-supplied views is not a credential and names no registry.
    ///         Check hasTrait on the trusted Registry for a credential.
    function tokenURIOf(address registry, uint256 tokenId) external view returns (string memory) {
        return tokenURI(cardOf(registry, tokenId));
    }

    /// @dev The renderer's input for a registry card: the frozen direct traits and verified oracle traits of
    ///      the minter. Internal for the size budget (`RendererHarness.cardOfOn` in the tests).
    function cardOf(address registry, uint256 tokenId) internal view returns (Card memory c) {
        ICardSource r = ICardSource(registry);
        address claimant = r.claimantOf(tokenId);
        if (claimant == address(0)) revert NoCard(tokenId);
        c.tokenId = tokenId;
        c.claimant = claimant;
        c.traits = _traits(registry, claimant);
        for (uint256 i; i < c.traits.length; ++i) {
            uint16 id = c.traits[i];
            uint256 fam = id / 100;
            // Ordinals are independent facts: retain the lowest verified id (the rarest).
            // Other families show their highest tier as the sorted ids are visited.
            if (fam != 11 || c.top[fam - 1] == 0) c.top[fam - 1] = id;
        }
        uint16[] memory specs = r.verifiedSpecsOf(claimant);
        c.communityCount = specs.length;
        uint256 shown = specs.length < MAX_COMMUNITY_IN_METADATA ? specs.length : MAX_COMMUNITY_IN_METADATA;
        c.community = new uint16[](shown);
        for (uint256 i; i < shown; ++i) {
            c.community[i] = specs[i];
        }
        // oracle metadata: the true catalog oracle ids (every one is a verified entry), then the shown specs
        uint256 n;
        for (uint256 i; i < c.traits.length; ++i) {
            if (c.traits[i] >= 601) n++;
        }
        c.oracle = new OracleMeta[](n + shown);
        uint256 k;
        for (uint256 i; i < c.traits.length; ++i) {
            if (c.traits[i] >= 601) c.oracle[k++] = _meta(r, claimant, c.traits[i]);
        }
        for (uint256 i; i < shown; ++i) {
            c.oracle[k++] = _meta(r, claimant, specs[i]);
        }
    }

    /// @dev Copy at most 25 catalog ids, even when a caller-supplied source returns a longer array.
    function _traits(address registry, address claimant) internal view returns (uint16[] memory ids) {
        bytes memory input = abi.encodeCall(ICardSource.traitsOf, (claimant));
        bytes memory ret = new bytes(27 * 32);
        bool ok;
        uint256 size;
        uint256 head;
        uint256 n;
        assembly ("memory-safe") {
            ok := staticcall(gas(), registry, add(input, 32), mload(input), add(ret, 32), mload(ret))
            size := returndatasize()
            head := mload(add(ret, 32))
            n := mload(add(ret, 64))
        }
        if (!ok || size < 64 || head != 32) revert UnknownTrait(0);
        if (n > 25) n = 25;
        if (size < 64 + 32 * n) revert UnknownTrait(0);
        ids = new uint16[](n);
        uint256 count;
        for (uint256 i; i < n; ++i) {
            uint256 id;
            assembly ("memory-safe") { id := mload(add(add(ret, 96), mul(i, 32))) }
            uint256 fam = id / 100;
            uint256 tier = id % 100;
            if (fam < 1 || fam > 13 || tier < 1 || tier > uint8(FAMILY_TIERS[fam - 1])) continue;
            ids[count++] = uint16(id);
        }
        assembly ("memory-safe") { mstore(ids, count) }
    }

    /// @dev Bound returndata before copying and validate every relative offset before reading.
    ///      The window comes from verified(), including the operator's stored living window.
    function _meta(ICardSource r, address claimant, uint16 traitId) internal view returns (OracleMeta memory m) {
        m.traitId = traitId;
        (m.requestId, m.oracleRequestId, m.fromBlock, m.toBlock) = r.verified(claimant, traitId);
        bytes memory input = abi.encodeWithSelector(0x701ce949, traitId);
        bytes memory ret = new bytes(1024);
        bool ok;
        uint256 size;
        assembly ("memory-safe") {
            ok := staticcall(gas(), r, add(input, 32), mload(input), add(ret, 32), 1024)
            size := returndatasize()
        }
        if (!ok || size < 13 * 32 || size > 1024) revert UnknownTrait(traitId);
        uint256 head;
        assembly ("memory-safe") { head := mload(add(ret, 32)) }
        if (head < 32 || head > size - 12 * 32) revert UnknownTrait(traitId);
        uint256 nameAt;
        assembly ("memory-safe") {
            let ptr := add(add(ret, 32), head)
            mstore(add(m, 32), and(mload(ptr), 0xff))
            mstore(add(m, 128), and(mload(add(ptr, 32)), 0xffffffffffffffffffffffffffffffffffffffff))
            nameAt := mload(add(ptr, 352))
        }
        if (nameAt < 12 * 32 || nameAt > size - head - 32) revert UnknownTrait(traitId);
        nameAt += head;
        uint256 nameLen;
        assembly ("memory-safe") { nameLen := mload(add(add(ret, 32), nameAt)) }
        if (nameLen > 32 || nameLen > size - nameAt - 32) revert UnknownTrait(traitId);
        bytes memory name = new bytes(nameLen);
        assembly ("memory-safe") { mcopy(add(name, 32), add(add(ret, 64), nameAt), nameLen) }
        m.name = string(name);
    }

    /// @notice The metadata JSON before Base64, public so a test can diff it against the golden.
    function preimage(Card memory c) internal pure returns (bytes memory out) {
        bytes[SLOTS] memory v = _values(c);
        bytes memory tpl = TemplateData.TEMPLATE;
        bytes memory offs = _unhex(TemplateData.OFFSETS);
        uint256 total = tpl.length;
        for (uint256 i; i < SLOTS; ++i) {
            total += v[i].length;
        }
        out = new bytes(total);
        uint256 off;
        for (uint256 i; i < SLICES; ++i) {
            uint256 start = (uint256(uint8(offs[4 * i])) << 8) | uint256(uint8(offs[4 * i + 1]));
            uint256 len = (uint256(uint8(offs[4 * i + 2])) << 8) | uint256(uint8(offs[4 * i + 3]));
            assembly ("memory-safe") {
                mcopy(add(add(out, 0x20), off), add(add(tpl, 0x20), start), len)
            }
            off += len;
            if (i == SLOTS) break; // the last slice has no value after it
            bytes memory val = v[i];
            uint256 vl = val.length;
            assembly ("memory-safe") {
                mcopy(add(add(out, 0x20), off), add(val, 0x20), vl)
            }
            off += vl;
        }
    }

    /// @dev Slot order: name id; image; JSON claimant, 13 family values, community count, community
    ///      attributes, traits list, community list, oracle metadata.
    function _values(Card memory c) internal pure returns (bytes[SLOTS] memory v) {
        v[0] = bytes(Strings.toString(c.tokenId));
        v[1] = image(c);
        v[2] = bytes(Strings.toHexString(c.claimant));
        for (uint256 f; f < 13; ++f) {
            v[3 + f] = c.top[f] == 0 ? bytes("none") : bytes(Strings.toString(c.top[f]));
        }
        v[16] = bytes(Strings.toString(c.communityCount));
        v[17] = _communityAttributes(c);
        v[18] = _list(c.traits);
        v[19] = _list(c.community);
        v[20] = _oracle(c.oracle);
    }

    // ------------------------------------------------------------------------------------------ the hive

    /// @notice The percent-encoded hive SVG of a card (the value after `data:image/svg+xml,`).
    /// @dev    Element order, per `tools/gen_template.py` `hive_svg`: the opening and background; for each
    ///         family in catalog order its outline, then its zones (clipped to the honey line when the
    ///         family is part-filled, with the rings outlined above the line), the rare dot, or the ring
    ///         outlines of an empty cell; the outer ring; the community path. The token id is not drawn
    ///         (it is the metadata name).
    function image(Card memory c) internal pure returns (bytes memory) {
        Hive memory h =
            Hive(HiveData.POINTS, _unhex(HiveData.POINT_STARTS), HiveData.FRAGMENTS, _unhex(HiveData.FRAGMENT_STARTS));
        Buf memory b = Buf(new bytes(8192), 0);
        _frag(b, h, HiveData.F_SVG_OPEN);
        uint256 shown = c.communityCount > MAX_RINGS_SHOWN ? MAX_RINGS_SHOWN : c.communityCount;
        for (uint256 i; i < 13; ++i) {
            _cell(b, h, i, c.top[i], _rings(shown, i));
        }
        _frag(b, h, HiveData.F_POLYGON_OPEN);
        _point(b, h, HiveData.V_INDEX);
        _frag(b, h, HiveData.F_V_CLOSE);
        uint256 steps = _steps(c.communityCount);
        if (steps > 0) {
            _frag(b, h, HiveData.F_PATH_OPEN);
            _point(b, h, HiveData.CORNER_BASE + 4);
            uint256 whole = 6 * steps / 64;
            for (uint256 m = 1; m <= whole; ++m) {
                _frag(b, h, HiveData.F_PATH_SEGMENT);
                _point(b, h, HiveData.CORNER_BASE + (4 + m) % 6);
            }
            if ((6 * steps) % 64 != 0) {
                _frag(b, h, HiveData.F_PATH_SEGMENT);
                _point(b, h, HiveData.END_BASE + (steps > 32 ? steps - 2 : steps - 1));
            }
            _frag(b, h, HiveData.F_PATH_CLOSE);
        }
        _frag(b, h, HiveData.F_SVG_CLOSE);
        return _finish(b);
    }

    /// @dev One family's cell: outline, zones or honey or empty rings, and the rare dot.
    function _cell(Buf memory b, Hive memory h, uint256 i, uint16 top, uint256 k) internal pure {
        (uint256 lv, uint256 n) = _level(i, top);
        uint256 colour = lv == 0 ? HiveData.F_COLOUR_OFF : _colour(i);
        uint256 hexBase = HiveData.HEX_BASE + 5 * i;
        _frag(b, h, HiveData.F_POLYGON_OPEN);
        _point(b, h, hexBase);
        _frag(b, h, HiveData.F_OUTER_STROKE);
        _frag(b, h, colour);
        _frag(b, h, HiveData.F_OUTER_CLOSE);
        if (lv == n) {
            _zones(b, h, hexBase, k, colour);
        } else if (lv > 0) {
            uint256 pair = HiveData.HONEY_BASE + 2 * _pair(i, lv);
            _frag(b, h, HiveData.F_CLIP_ABOVE_OPEN);
            _put(b, bytes(Strings.toString(i)));
            _frag(b, h, HiveData.F_CLIP_POLYGON);
            _point(b, h, pair + 1);
            _frag(b, h, HiveData.F_CLIP_ABOVE_CLOSE);
            _put(b, bytes(Strings.toString(i)));
            _frag(b, h, HiveData.F_CLIP_POLYGON);
            _point(b, h, pair);
            _frag(b, h, HiveData.F_CLIP_HONEY_CLOSE);
            _put(b, bytes(Strings.toString(i)));
            _frag(b, h, HiveData.F_GROUP_OPEN);
            _zones(b, h, hexBase, k, colour);
            _frag(b, h, HiveData.F_GROUP_CLOSE);
            for (uint256 r; r < k; ++r) {
                _frag(b, h, HiveData.F_POLYGON_OPEN);
                _point(b, h, hexBase + 2 + r);
                _frag(b, h, HiveData.F_RING_CLIPPED);
                _put(b, bytes(Strings.toString(i)));
                _frag(b, h, HiveData.F_CLIPPED_CLOSE);
            }
        }
        if (lv > 0 && _rare(top)) {
            _frag(b, h, HiveData.F_CIRCLE_OPEN);
            _point(b, h, HiveData.CENTRE_BASE + i);
            _frag(b, h, HiveData.F_CIRCLE_CLOSE);
        }
        if (lv == 0) {
            for (uint256 r; r < k; ++r) {
                _frag(b, h, HiveData.F_POLYGON_OPEN);
                _point(b, h, hexBase + 2 + r);
                _frag(b, h, HiveData.F_RING_EMPTY);
            }
        }
    }

    /// @dev The filled cell (r = 77) and its k community rings, with the opacities of the k-row.
    function _zones(Buf memory b, Hive memory h, uint256 hexBase, uint256 k, uint256 colour) internal pure {
        for (uint256 z; z <= k; ++z) {
            _frag(b, h, HiveData.F_POLYGON_OPEN);
            _point(b, h, hexBase + 1 + z);
            _frag(b, h, HiveData.F_ZONE_FILL);
            _frag(b, h, colour);
            _frag(b, h, HiveData.F_ZONE_OPACITY);
            _frag(b, h, _opacity(k, z));
            _frag(b, h, HiveData.F_CLOSE);
        }
    }

    /// @dev Opacities by ring count k: 0 [1.00]; 1 [0.35, 1.00]; 2 [0.35, 0.68, 1.00]; 3 [0.35, 0.57, 0.78, 1.00].
    function _opacity(uint256 k, uint256 z) internal pure returns (uint256) {
        if (z == k) return HiveData.F_OPACITY_100;
        if (z == 0) return HiveData.F_OPACITY_35;
        if (k == 2) return HiveData.F_OPACITY_68;
        return z == 1 ? HiveData.F_OPACITY_57 : HiveData.F_OPACITY_78;
    }

    /// @dev Tier level of a family's top id and the family's tier count; Ordinal (family 10) is one level.
    ///      An id outside its family's tier list (never produced by the registry) is clamped, never reverted.
    function _level(uint256 i, uint16 top) internal pure returns (uint256 lv, uint256 n) {
        n = i == 1 ? 2 : i == 2 ? 3 : i == 3 ? 4 : i == 4 ? 3 : 1;
        if (top == 0) return (0, n);
        if (i == 10) return (1, n);
        lv = top % 100;
        if (lv == 0) lv = 1;
        if (lv > n) lv = n;
    }

    /// @dev Index of the part-filled (family, lv) pair in HiveData's HONEY/ABOVE order.
    function _pair(uint256 i, uint256 lv) internal pure returns (uint256) {
        return (i == 1 ? 0 : i == 2 ? 1 : i == 3 ? 3 : 6) + lv - 1;
    }

    function _colour(uint256 i) internal pure returns (uint256) {
        if (i < 5) return HiveData.F_COLOUR_DIRECT;
        if (i == 5) return HiveData.F_COLOUR_PANEL;
        if (i <= 10) return HiveData.F_COLOUR_CHAIN;
        return i == 11 ? HiveData.F_COLOUR_SHARED : HiveData.F_COLOUR_PANEL;
    }

    function _rare(uint16 top) internal pure returns (bool) {
        return top == 202 || top == 801 || top == 901 || top == 1001 || top == 1201 || (top >= 1101 && top <= 1104);
    }

    /// @dev Rings of family i: slot s = 0 for Swarmed, 1..5 for Spawned..Benchmarked, else the family index;
    ///      k = #{d in 0..2 : 13d + s < shown}.
    function _rings(uint256 shown, uint256 i) internal pure returns (uint256) {
        uint256 s = i == 5 ? 0 : (i < 5 ? i + 1 : i);
        if (shown > s + 26) return 3;
        if (shown > s + 13) return 2;
        return shown > s ? 1 : 0;
    }

    /// @dev Community path length in 64ths: none up to 39, 64 from 8192, else bitlen(count^8) - 41.
    function _steps(uint256 count) internal pure returns (uint256 steps) {
        if (count <= MAX_RINGS_SHOWN) return 0;
        if (count >= 8192) return 64;
        uint256 p = count ** 8;
        uint256 bits;
        while (p > 0) {
            p >>= 1;
            ++bits;
        }
        steps = bits - 41;
        if (steps > 64) steps = 64;
    }

    function _frag(Buf memory b, Hive memory h, uint256 index) internal pure {
        _slice(b, h.fragments, h.fragmentStarts, index);
    }

    function _point(Buf memory b, Hive memory h, uint256 index) internal pure {
        _slice(b, h.points, h.pointStarts, index);
    }

    function _slice(Buf memory b, bytes memory blob, bytes memory starts, uint256 index) internal pure {
        uint256 start = (uint256(uint8(starts[2 * index])) << 8) | uint256(uint8(starts[2 * index + 1]));
        uint256 end = (uint256(uint8(starts[2 * index + 2])) << 8) | uint256(uint8(starts[2 * index + 3]));
        _append(b, blob, start, end - start);
    }

    function _put(Buf memory b, bytes memory s) internal pure {
        _append(b, s, 0, s.length);
    }

    function _append(Buf memory b, bytes memory src, uint256 start, uint256 len) internal pure {
        if (b.len + len > b.data.length) {
            bytes memory grown = new bytes(2 * b.data.length + len);
            bytes memory old = b.data;
            uint256 used = b.len;
            assembly ("memory-safe") {
                mcopy(add(grown, 0x20), add(old, 0x20), used)
            }
            b.data = grown;
        }
        bytes memory data = b.data;
        uint256 at = b.len;
        assembly ("memory-safe") {
            mcopy(add(add(data, 0x20), at), add(add(src, 0x20), start), len)
        }
        b.len = at + len;
    }

    function _finish(Buf memory b) internal pure returns (bytes memory out) {
        out = b.data;
        uint256 len = b.len;
        assembly ("memory-safe") {
            mstore(out, len)
        }
    }

    // ------------------------------------------------------------------------------------------ the JSON

    /// @dev Standard marketplace attributes carry both the community id and its escaped name.
    ///      Registry.cardOf supplies the first 32 ids and the matching oracle metadata in order.
    function _communityAttributes(Card memory c) internal pure returns (bytes memory) {
        Buf memory b = Buf(new bytes(2048), 0);
        for (uint256 i; i < c.community.length; ++i) {
            string memory name;
            for (uint256 j; j < c.oracle.length; ++j) {
                if (c.oracle[j].traitId == c.community[i]) {
                    name = c.oracle[j].name;
                    break;
                }
            }
            _put(b, ',{"trait_type":"Community ');
            _put(b, bytes(Strings.toString(c.community[i])));
            _put(b, '","value":"');
            _put(b, escapeJson(bytes(name)));
            _put(b, '"}');
        }
        return _finish(b);
    }

    function _list(uint16[] memory ids) internal pure returns (bytes memory) {
        Buf memory b = Buf(new bytes(256), 0);
        for (uint256 i; i < ids.length; ++i) {
            if (i != 0) _put(b, ",");
            _put(b, bytes(Strings.toString(ids[i])));
        }
        return _finish(b);
    }

    function _oracle(OracleMeta[] memory ms) internal pure returns (bytes memory) {
        Buf memory b = Buf(new bytes(8192), 0);
        for (uint256 i; i < ms.length; ++i) {
            if (i != 0) _put(b, ",");
            _one(b, ms[i]);
        }
        return _finish(b);
    }

    /// @dev The oracle record: id, template, evidence, window, panel minima, the two request ids, the
    ///      target and the name. The spec body (`item`, `arg`, `fixedArg`, `sumArg`, `fixedVal`, `op`,
    ///      `threshold`) stays readable through `Registry.specOf(id)`. Kinds 1, 2 and 4 ask a 5 / 3
    ///      panel; kinds 3, 5 and 6 ask 11 / 7.
    function _one(Buf memory b, OracleMeta memory m) internal pure {
        bool panel = m.kind == 3 || m.kind == 5 || m.kind == 6;
        _put(b, '{"traitId":');
        _put(b, bytes(Strings.toString(m.traitId)));
        _put(b, ',"template":"T');
        _put(b, bytes(Strings.toString(m.kind)));
        _put(b, '","evidence":"');
        _put(b, (m.kind == 5 || m.kind == 6) ? bytes("panel") : bytes("chain"));
        _put(b, '","fromBlock":');
        _put(b, bytes(Strings.toString(m.fromBlock)));
        _put(b, ',"toBlock":');
        _put(b, bytes(Strings.toString(m.toBlock)));
        _put(b, ',"minPanelSize":');
        _put(b, panel ? bytes("11") : bytes("5"));
        _put(b, ',"minQuorum":');
        _put(b, panel ? bytes("7") : bytes("3"));
        _put(b, ',"requestId":"');
        _put(b, bytes(Strings.toHexString(uint256(m.requestId), 32)));
        _put(b, '","oracleRequestId":"');
        _put(b, bytes(Strings.toHexString(uint256(m.oracleRequestId), 32)));
        _put(b, '","target":"');
        _put(b, bytes(Strings.toHexString(m.target)));
        _put(b, '","name":"');
        _put(b, escapeJson(bytes(m.name)));
        _put(b, '"}');
    }

    /// @notice JSON string escaping that also neutralises markup: `"` and `\` are escaped, and every
    ///         byte below 0x20 plus `<`, `>`, `&`, single quote becomes a `\u00XX` escape, so a hostile spec string
    ///         can break neither the JSON nor an SVG a viewer might paste it into.
    function escapeJson(bytes memory s) internal pure returns (bytes memory out) {
        uint256 extra;
        for (uint256 i; i < s.length; ++i) {
            bytes1 ch = s[i];
            if (ch == '"' || ch == "\\") extra += 1;
            else if (ch < 0x20 || ch == "<" || ch == ">" || ch == "&" || ch == "'") extra += 5;
        }
        if (extra == 0) return s;
        out = new bytes(s.length + extra);
        uint256 o;
        for (uint256 i; i < s.length; ++i) {
            bytes1 ch = s[i];
            if (ch == '"' || ch == "\\") {
                out[o++] = "\\";
                out[o++] = ch;
            } else if (ch < 0x20 || ch == "<" || ch == ">" || ch == "&" || ch == "'") {
                out[o++] = "\\";
                out[o++] = "u";
                out[o++] = "0";
                out[o++] = "0";
                uint8 hi = uint8(ch) >> 4;
                uint8 lo = uint8(ch) & 0xf;
                out[o++] = bytes1(hi < 10 ? 48 + hi : 87 + hi);
                out[o++] = bytes1(lo < 10 ? 48 + lo : 87 + lo);
            } else {
                out[o++] = ch;
            }
        }
    }
}
